      "Bash(gh workflow:*)",
      "Bash(gh issue:*)",

      {{- /* === Common Unix Utilities === */}}
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
