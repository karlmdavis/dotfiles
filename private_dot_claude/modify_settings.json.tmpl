#!/bin/sh
# chezmoi modify_ script for ~/.claude/settings.json.
#
# The base settings are version-controlled below. Machine-specific overrides live in
# ~/.claude/settings.local.json (this repo's overlay, not a Claude Code file) and are
# merged on top at apply time; the merge block below is the canonical description of
# the rules. Claude Code rewrites settings.json at runtime: it reorders keys and
# persists a few choices of its own (e.g. `/model` writes `model`). So:
#   - runtime-owned top-level keys (RUNTIME_KEYS below) are carried through from the
#     live file;
#   - the comparison is semantic (via jq -S): if the live file equals our merged
#     desired settings, emit the live bytes unchanged (byte-exact, so no diff);
#   - otherwise emit the merged desired settings (chezmoi wins).
# stdout is the file, so all diagnostics go to stderr.
set -eu

# Read stdin byte-exactly: $(...) would strip trailing newlines, and Claude Code
# writes the file with one, so a stripped pass-through would differ by one byte
# and show as modified forever.
live="$(cat; printf x)"
live="${live%x}"
[ -n "$live" ] || live='{}'

desired="$(cat <<'SETTINGS_JSON'
{
  "cleanupPeriodDays": 36525,
  "attribution": {
