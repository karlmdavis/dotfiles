class OverlayError(Exception):
    """The overlay file is unusable; the apply must abort rather than drop settings.

    Messages describe the problem only; `main` prefixes the overlay path.
    """


def json_type(value: Any) -> str:
    """JSON type name of a parsed value, for error messages."""
    return {dict: "object", list: "array", str: "string", bool: "boolean"}.get(
        type(value), "null" if value is None else "number"
    )


def merge(committed: Any, overlay: Any, where: str = "") -> Any:
    """Merge an overlay value onto a committed one.

    Objects merge recursively. Lists are unioned: overlay entries are appended in
    overlay order, skipping any already present, so a local allow/deny list can only
    ever add to the committed one. A committed scalar, or a key the template doesn't
    have, takes any overlay value. A committed object/list takes only the same kind,
    or `null` (which replaces it; what Claude Code makes of a null key is up to it).
    Anything else is a mistake in the overlay and aborts. `where` is the dotted key
    path of `committed`, for that error message.
    """
    if isinstance(committed, dict) and isinstance(overlay, dict):
        merged = dict(committed)
        for key, value in overlay.items():
            child = f"{where}.{key}" if where else key
            merged[key] = merge(merged.get(key), value, child)
        return merged
    if isinstance(committed, list) and isinstance(overlay, list):
        union = list(committed)
        union.extend(item for item in overlay if item not in union)
        return union
    if isinstance(committed, (dict, list)) and overlay is not None:
        raise OverlayError(
            f"at {where or '<root>'}: overlay tries to replace a committed "
            f"{json_type(committed)} with {json_type(overlay)} (only null may do that)"
        )
    return overlay


def load_overlay(path: Path) -> dict[str, Any]:
    """Read the overlay as one JSON object; absent, empty, or comment-only means {}."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        if path.is_symlink():
            raise OverlayError(f"dangling symlink ({exc})") from exc
        return {}
    except (OSError, UnicodeDecodeError) as exc:
        # Directory, permissions, not UTF-8, and anything else the OS objects to.
        raise OverlayError(f"cannot read as a UTF-8 text file ({exc})") from exc
    # Comment lines are blanked, not removed, so JSON error positions match the file.
    text = COMMENT_LINE.sub("", text)
    if not text.strip():
        return {}
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise OverlayError(f"not valid JSON ({exc}); fix or delete it") from exc
    if not isinstance(data, dict):
        raise OverlayError("must be exactly one JSON object; fix or delete it")
    return data


def parse_live(raw: bytes) -> dict[str, Any] | None:
    """Parse the live file; None if it is not exactly one JSON object.

    Empty stdin is chezmoi's signal that the target does not exist yet (first apply),
    so it is an empty object rather than an error.
    """
    if not raw.strip():
        return {}
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def main() -> int:
    """Read the live file on stdin, print the file chezmoi should write."""
    raw_live = sys.stdin.buffer.read()
    live = parse_live(raw_live)
    overlay_path = Path(os.environ.get("CLAUDE_SETTINGS_LOCAL") or DEFAULT_OVERLAY)

    try:
        overlay = load_overlay(overlay_path)
        desired = merge(json.loads(TEMPLATE), overlay)
    except OverlayError as exc:
        print(f"settings.json: {overlay_path}: {exc}", file=sys.stderr)
        return 1

    if live is None:
        print(
            "settings.json: live file is not a JSON object; replacing it with the "
            "managed settings (runtime keys such as model are lost unless the overlay "
            "sets them)",
            file=sys.stderr,
        )
    else:
        runtime = {key: live[key] for key in RUNTIME_KEYS if key in live}
        desired = {**runtime, **desired}
        if live == desired:  # dict equality is key-order-insensitive
            sys.stdout.buffer.write(raw_live)
            return 0

    # Trailing newline, as Claude Code's own writer emits. Written as UTF-8 bytes,
    # like the pass-through path, so the result does not depend on the locale.
    rendered = json.dumps(desired, indent=2, ensure_ascii=False) + "\n"
    sys.stdout.buffer.write(rendered.encode("utf-8"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
