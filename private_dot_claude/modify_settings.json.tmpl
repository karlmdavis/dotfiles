#!/usr/bin/env -S uv run --quiet --no-project --no-config --script
"""chezmoi modify_ script for ~/.claude/settings.json.

chezmoi's contract for a modify_ script: on every `chezmoi apply`/`diff`/`status` it
runs this script with the CURRENT contents of the target file on stdin, and whatever
the script prints to stdout becomes the file's new contents (nothing is written if
the script exits non-zero). So "live" below is the file as it exists on this machine
right now, including whatever Claude Code last wrote to it.

The base settings are version-controlled in TEMPLATE below. Machine-specific
overrides live in ~/.claude/settings.local.json (this repo's overlay, not a Claude
Code file) and are merged on top at apply time; see `merge` for the rules.

Claude Code rewrites settings.json at runtime: it reorders keys and persists a few
choices of its own (e.g. `/model` writes `model`). So:
  - runtime-owned top-level keys (RUNTIME_KEYS) are carried through from the live
    file; template and overlay values still win where both define a key;
  - if the live file is semantically equal to the merged desired settings, the live
    bytes are emitted unchanged (byte-exact, so no diff);
  - otherwise the merged desired settings are emitted (chezmoi wins).

stdout is the file, so all diagnostics go to stderr. Requires only the Python
standard library. The shebang runs the script through `uv run --script`, which reads
the inline metadata below and picks (or fetches) some interpreter satisfying the
declared Python floor, usually the newest available, so the floor is a constraint
rather than the version under test. `--no-project --no-config` keep uv from picking
up a pyproject or uv.toml from whatever directory chezmoi happens to be run in. The
bats suite executes this same shebang, so tests and production share one entry
point. uv comes from the system package manifest, whose script chezmoi applies
before this file only because `.chezmoiscripts/` sorts before `.claude/`; a rename
of either would change that.
"""

# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from typing import Any, Final

# Top-level keys whose value is legitimately chosen inside Claude Code per machine
# (`/model` saves `model`). Keep this list short: when Claude Code starts persisting
# some other key, declare it in TEMPLATE (chezmoi wins) rather than adding it here,
# unless it genuinely should vary per machine and be set from inside Claude Code.
RUNTIME_KEYS: Final = ("model",)

# CLAUDE_SETTINGS_LOCAL overrides the overlay path (test seam).
DEFAULT_OVERLAY: Final = Path("{{ .chezmoi.homeDir }}/.claude/settings.local.json")

# Only whole-line `//` comments are supported in the overlay (no trailing comments).
COMMENT_LINE: Final = re.compile(r"^[ \t]*//.*$", re.MULTILINE)

TEMPLATE: Final = r"""
