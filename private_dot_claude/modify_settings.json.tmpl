class OverlayError(Exception):
    """The overlay file is unusable; the apply must abort rather than drop settings."""


def json_type(value: Any) -> str:
    """JSON type name of a parsed value, for error messages."""
    return {dict: "object", list: "array", str: "string", bool: "boolean"}.get(
        type(value), "null" if value is None else "number"
    )


def merge(committed: Any, overlay: Any, where: str) -> Any:
    """Merge an overlay value onto a committed one.

    Objects merge recursively. Lists are unioned: overlay entries are appended
    without duplicates and in order, so a local allow/deny list can only ever add
    to the committed one. A committed scalar, or a key the template doesn't have,
    takes any overlay value. A committed object/list takes only the same kind, or
    `null` (which replaces it; what Claude Code makes of a null key is up to it).
    Anything else is a mistake in the overlay and aborts.
    """
    if isinstance(committed, dict) and isinstance(overlay, dict):
        merged = dict(committed)
        for key, value in overlay.items():
            merged[key] = merge(merged.get(key), value, f"{where}.{key}")
        return merged
    if isinstance(committed, list) and isinstance(overlay, list):
        union = list(committed)
        union.extend(item for item in overlay if item not in union)
        return union
    if isinstance(committed, (dict, list)) and overlay is not None:
        raise OverlayError(
            f"{where} tries to replace a committed {json_type(committed)} with "
            f"{json_type(overlay)} (only null may do that)"
        )
    return overlay


def load_overlay(path: Path) -> dict[str, Any]:
    """Read the overlay as one JSON object; absent, empty, or comment-only means {}."""
    if not path.exists() and not path.is_symlink():
        return {}
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        # Directory, dangling symlink, permissions, or not UTF-8: all name the path.
        raise OverlayError(f"{path}: cannot read as a UTF-8 text file ({exc})") from exc
    text = COMMENT_LINE.sub("", text)
    if not text.strip():
        return {}
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise OverlayError(
            f"{path}: not valid JSON ({exc}; line/column refer to the text with "
            "whole-line // comments removed); fix or delete it"
        ) from exc
    if not isinstance(data, dict):
        raise OverlayError(f"{path}: must be exactly one JSON object; fix or delete it")
    return data


def parse_live(raw: bytes) -> dict[str, Any] | None:
    """Parse the live file; None if it is not exactly one JSON object."""
    if not raw.strip():
        return {}
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def main() -> int:
    """Read the live file on stdin, print the file chezmoi should write."""
    raw_live = sys.stdin.buffer.read()
    live = parse_live(raw_live)
    overlay_path = Path(os.environ.get("CLAUDE_SETTINGS_LOCAL") or DEFAULT_OVERLAY)

    try:
        overlay = load_overlay(overlay_path)
        desired = merge(json.loads(TEMPLATE), overlay, str(overlay_path))
    except OverlayError as exc:
        print(f"settings.json: {exc}", file=sys.stderr)
        return 1

    if live is None:
        print(
            "settings.json: live file is not a JSON object; replacing it with the "
            "managed settings (runtime keys such as model are lost unless the overlay "
            "sets them)",
            file=sys.stderr,
        )
    else:
        runtime = {key: live[key] for key in RUNTIME_KEYS if key in live}
        desired = {**runtime, **desired}
        if live == desired:  # dict equality is key-order-insensitive
            sys.stdout.buffer.write(raw_live)
            return 0

    # Trailing newline, as Claude Code's own writer emits.
    sys.stdout.write(json.dumps(desired, indent=2, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
