#!/bin/bash

##
# Keeps the Todoist CLI's bundled Claude Code skill in step with the `td` alias's pinned version.
#
# The `td` alias (.chezmoitemplates/shell-aliases.sh for bash/zsh, .chezmoitemplates/config.nu for
# nushell) runs the CLI via a pinned `npx --package=...` fetch. That CLI ships its OWN Claude Code
# skill -- author "Doist", not ours -- which it installs to ~/.claude/skills/todoist-cli/SKILL.md via
# `td skill install claude-code`. The skill documents a version-specific command surface, so one left
# behind at an older version will confidently describe flags and subcommands that no longer exist.
# The skill is therefore NOT chezmoi-managed source: the CLI owns that file, and this script only
# makes sure the right version of the CLI has written it.
#
# The version is pinned in exactly one place, .chezmoidata/tool_versions.yaml. That pin is rendered
# into this script below, so bumping it there changes this script's content hash, which is what makes
# chezmoi re-run this script -- the alias and the skill move together, from a one-line edit.
#
# This is a run_onchange_ script, so chezmoi records its content hash after a successful (exit 0) run
# and stays quiet in `chezmoi status` until the pin changes again. That recording is also why this
# script must not exit 0 without having done its job: a "skipped" run would be recorded just like a
# successful one, and the stale skill would sit there unnoticed until the next version bump. Hence the
# node bootstrap below rather than a skip, and a hard failure if even that is impossible.
##

set -euo pipefail

PIN='{{ .tools.todoist_cli }}'
VERSION="${PIN##*@}"

# The CLI is fetched with npx, so node has to exist. The package manifest installs volta (and, being
# named `system_packages_autoinstall`, sorts before this script, so it has already run), but volta
# installs no toolchain by default -- a freshly-provisioned machine has volta and no node.
if ! command -v npx >/dev/null 2>&1; then
  if command -v volta >/dev/null 2>&1; then
    echo "todoist-cli skill: no node toolchain yet; installing one via volta ..."
    volta install node
  fi
fi

# Still nothing: fail loudly rather than exit 0, which would record the hash and hide the stale skill.
if ! command -v npx >/dev/null 2>&1; then
  echo "todoist-cli skill: npx unavailable and volta could not provide it." >&2
  echo "  Install node, then re-run 'chezmoi apply' to install the ${VERSION} skill." >&2
  exit 1
fi

echo "todoist-cli skill: installing ${VERSION} ..."
# --force because the CLI refuses to overwrite an existing SKILL.md (ALREADY_EXISTS); overwriting is
# exactly the point here, since the file is vendor output rather than anything hand-edited.
npx --yes --package="$PIN" -- td skill install claude-code --force
