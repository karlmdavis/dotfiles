#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""zellij-gc — delete zellij sessions abandoned at the welcome screen (thin launcher shim).

Started in the background by ~/.local/bin/zellij-welcome, or run by hand:
  zellij-gc [--dry-run]

The real logic lives in the zellij_gc package at ~/.local/lib/zellij-gc (an embedded mini-project,
so its code and pytest tests live together). The shebang runs this through `uv` (found on PATH),
which supplies Python >= 3.11; there are no third-party dependencies.
"""

import os
import sys

# This is a standalone script, not an installed package, so the package dir is added to sys.path
# explicitly. $ZELLIJ_GC_LIB_DIR overrides it (the seam for running the source package instead of
# the applied copy).
sys.path.insert(
    0,
    os.environ.get("ZELLIJ_GC_LIB_DIR", os.path.expanduser("~/.local/lib/zellij-gc")),
)

from zellij_gc.gc import main

if __name__ == "__main__":
    sys.exit(main())
