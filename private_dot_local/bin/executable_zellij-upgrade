#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""zellij-upgrade — upgrade zellij and put every session back where it was (thin launcher shim).

Run by hand:
  zellij-upgrade [--dry-run] [--yes] [--force]

The real logic lives in the zellij_upgrade package at ~/.local/lib/zellij-upgrade (an embedded
mini-project, so its code and pytest tests live together). The shebang runs this through `uv`
(found on PATH), which supplies Python >= 3.11; there are no third-party dependencies.
"""

import os
import sys
from pathlib import Path

# This is a standalone script, not an installed package, so the package dir is added to sys.path
# explicitly. $ZELLIJ_UPGRADE_LIB_DIR overrides it (the seam for running the source package instead
# of the applied copy).
sys.path.insert(
    0,
    os.environ.get("ZELLIJ_UPGRADE_LIB_DIR") or str(Path.home() / ".local/lib/zellij-upgrade"),
)

from zellij_upgrade.cli import main

if __name__ == "__main__":
    sys.exit(main())
