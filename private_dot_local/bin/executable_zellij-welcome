#!/bin/sh

##
# zellij-welcome — open the zellij 'welcome' session chooser, tidying up behind it.
#
# The single entry point for every terminal that lands in zellij: the login-shell launcher
# (.chezmoitemplates/zellij-launch.sh) and the iTerm2 `zellij` profile, which runs this without a
# login shell, so with only the system default PATH. Each launch also starts zellij-gc in the
# background, which deletes sessions abandoned at the welcome screen (disable by setting
# ZELLIJ_GC_DISABLE to anything non-empty).
##

# `--check` only proves that this script can start; callers probe with it before they exec.
[ "${1:-}" = --check ] && exit 0

# Homebrew's bin dir, probed at runtime (Apple-silicon macOS, then Linux). Not templated per OS,
# so that shellcheck can lint this file as it is.
brew_bin=""
for dir in /opt/homebrew/bin /home/linuxbrew/.linuxbrew/bin; do
  if [ -d "$dir" ]; then
    brew_bin="$dir"
    break
  fi
done

# Collect abandoned sessions, detached so the chooser never waits on it, and deaf to the hangup
# sent when the terminal closes. Homebrew's bin goes on PATH for this child only: the shim's
# shebang needs `uv`, and the collector runs a bare `zellij`. The chooser itself inherits the
# caller's environment unchanged.
#
# Nothing may reach the terminal, so a failed run's output is kept in last-failure.log instead
# (the collector's own log cannot record a failure to start). It is one file, written whole and
# renamed into place, so concurrent launches cannot corrupt it and it cannot grow.
if [ -x "$HOME/.local/bin/zellij-gc" ]; then
  (
    trap '' HUP
    output=$(PATH="${brew_bin:+$brew_bin:}$PATH" "$HOME/.local/bin/zellij-gc" 2>&1)
    status=$?
    if [ "$status" -ne 0 ]; then
      state="${XDG_STATE_HOME:-$HOME/.local/state}/zellij-gc"
      mkdir -p "$state" &&
        printf '%s zellij-gc exited %s\n%s\n' "$(date)" "$status" "$output" \
          >"$state/last-failure.log.$$" &&
        mv -f "$state/last-failure.log.$$" "$state/last-failure.log"
    fi
  ) </dev/null >/dev/null 2>&1 &
fi

# Prefer zellij from PATH; fall back to Homebrew's copy for callers with a bare PATH (the iTerm2
# profile). `exec` replaces this script with zellij, so nothing below it runs afterwards: when a
# session is detached or quit, what ends is zellij itself, with zellij's exit status.
if command -v zellij >/dev/null 2>&1; then
  exec zellij -l welcome
elif [ -n "$brew_bin" ] && [ -x "$brew_bin/zellij" ]; then
  exec "$brew_bin/zellij" -l welcome
fi

# Reached only when neither exec above ran, which is when zellij is not installed.
echo "zellij-welcome: zellij not found" >&2
exit 127
