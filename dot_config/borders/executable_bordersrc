#!/usr/bin/env bash
# JankyBorders config: a thin border around the focused window only.
#
# `borders` runs this file when its first instance starts with no arguments (AeroSpace launches it
# that way from after-startup-command in ~/.aerospace.toml). The `borders` call at the bottom then
# hands the options to that running instance. Re-running this file live-updates it, which is what
# `chezmoi apply` does after an edit; with no instance running, the same call BECOMES the daemon
# and does not return.
#
# Colors are 0xAARRGGBB. The accent is hard-coded from the terminal palette (Tokyo Night Storm,
# see the iTerm2 README in the chezmoi source); update it by hand if the palette moves.

options=(
  style=round

  # For style=round only about half the width shows outside the window, so this is a ~2pt border;
  # AeroSpace's gaps are 2 to match, which leaves the border exactly filling the gap. Keep this a
  # whole number: fractional widths leave rendering artifacts.
  width=4.0

  # Render at Retina resolution; without it the border is soft on a scaled display. This is the
  # expensive setting: borders keeps a surface for every open window, focused or not, so memory
  # scales with the window count. Measured with 46 windows open: ~1.3 GB at hidpi=on, ~320 MB at
  # hidpi=off.
  hidpi=on

  # Tokyo Night Storm blue.
  active_color=0xff7aa2f7

  # Fully transparent. AeroSpace parks the windows of hidden workspaces as slivers in a screen
  # corner, and a visible inactive border would outline every one of them.
  inactive_color=0x00000000
)

borders "${options[@]}"
