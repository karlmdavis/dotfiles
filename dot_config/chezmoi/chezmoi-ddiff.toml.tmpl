##
# Config behind the `chezmoi-ddiff` shell alias: the live chezmoi config plus difftastic as the
# diff command.
#
# chezmoi has no command-line flag for the diff command; it only reads `diff.command` from a
# config file. Setting it in the main config would change plain `chezmoi diff` for everything,
# scripts and agents included, so the alias passes this file via `--config` instead. The live
# config is included verbatim so `[data]` etc. are never duplicated, and sitting beside it means
# both share the same persistent state. The path is spelled out rather than taken from
# `.chezmoi.configFile` because under `chezmoi-ddiff` that variable names this file itself.
##
{{ include (joinPath .chezmoi.homeDir ".config/chezmoi/chezmoi.toml") }}
[diff]
    command = "difft"
